# Copy to .env and fill secrets. Never commit .env.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_PRIMARY_MODEL=muse-spark-1.3
META_ADVANCED_MODEL=muse-wonder-1.0
META_TIMEOUT_S=30
# Engine store. Files (GENESIS_DATA_DIR) always work. Set DATABASE_URL
# (Railway Postgres plugin) and the engine uses real tables
# (genesis_kv / genesis_hits / genesis_experience) instead.
GENESIS_DATA_DIR=/data
# DATABASE_URL=postgresql://user:pass@host:5432/db
# Editor origins allowed to call the API (comma-separated, no spaces).
# Local defaults are baked in; add the public editor origin on deploy.
GENESIS_CORS_ORIGINS=https://genesis.webstudiobhiwadi.com
# Public API base baked into the editor at build time.
NEXT_PUBLIC_GENESIS_API=https://genesis-api.webstudiobhiwadi.com
# Website deployments MUST set this to 1: the API refuses file mode and
# boots Postgres-only (sessions, projects index, memory, rate limits).
# Laptop/terminal use leaves it unset (files, full local authority, no login).
# GENESIS_REQUIRE_DB=1
# Outgoing mail for login OTPs (any SMTP: Gmail App Password works).
# Unset = /api/auth/request answers 503 honestly, nothing pretends.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# Exact model IDs for generation (advanced) and chat (primary).
# Defaults work if your key can see them; override when Meta gives you
# different IDs (e.g. a Wonder Full ID for the writer).
# META_ADVANCED_MODEL=
# META_PRIMARY_MODEL=
